{
  "name": "moudarir/mime-detector",
  "description": "A PHP library for detecting the real MIME type of files by analyzing their content.",
  "type": "library",
  "homepage": "https://github.com/moudarir/mime-detector",
  "license": "MIT",
  "keywords": [
    "mime",
    "mime-type",
    "detector",
    "file",
    "filetype",
    "magic-number",
    "php"
  ],
  "authors": [
    {
      "name": "Abdessamad MOUDARIR",
      "email": "amoudarir@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/moudarir/mime-detector/issues",
    "source": "https://github.com/moudarir/mime-detector"
  },
  "require": {
    "php": ">=8.4 <9.0",
    "ext-fileinfo": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4" : {
      "Moudarir\\MimeDetector\\" : "src/"
    }
  }
}
